{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "oxc", "typescript", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["build/**", ".react-router/**", "coverage/**"]
}
