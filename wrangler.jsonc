{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightbar-web",
  "main": "./workers/api.ts",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "lightbar.wywiol.eu", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightbar",
      "database_id": "d1af32c2-0a04-485f-bda1-e399b455e439",
      "migrations_dir": "migrations",
    },
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "lightbar-preview",
        "database_id": "9f493d4d-15ad-4180-b479-8a9a40236b75",
        "migrations_dir": "migrations",
      },
    ],
  },
}
